# Free API key from https://console.groq.com (sign up, no credit card needed)
GROQ_API_KEY=

# Groq model to use — free tier, fast. Change if it's deprecated.
GROQ_MODEL=llama-3.1-8b-instant

# edge-tts voice. Run `edge-tts --list-voices` to see all free options.
# Good student-friendly picks: en-US-AndrewNeural, en-US-AriaNeural, en-GB-SoniaNeural
EDGE_VOICE=en-US-AndrewNeural
